# Copy to .env for local Docker Compose. Secrets (JWT keys, broker KEK) are
# generated into a shared volume by the `secrets-init` service, so you do NOT
# set them here. For running processes outside Docker, point the *_FILE paths
# at local files or set the inline *_PEM / *_B64 variables.

APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=algo-api

# Observability. The API serves Prometheus metrics at /metrics; background
# processes expose theirs on METRICS_PORT. Restrict /metrics to the scrape
# network at the ingress layer — it is not authenticated.
METRICS_ENABLED=true
METRICS_NAMESPACE=algo
METRICS_PORT=9100
# Consumed by deploy/compose/docker-compose.observability.yml (not the app):
# ALERT_SLACK_WEBHOOK_URL=
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me

# Infrastructure (Docker service hostnames).
DATABASE_URL=postgresql+asyncpg://algo:algo@postgres:5432/algo
DATABASE_POOL_SIZE=10
REDIS_URL=redis://redis:6379/0

# Auth / JWT. In Docker these files are provided by secrets-init.
JWT_ISSUER=algo-matrics
JWT_AUDIENCE=algo-matrics-api
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
WS_TICKET_TTL_SECONDS=60

# Broker credential envelope encryption (KEK provided by secrets-init in Docker).
BROKER_CREDENTIAL_KEK_FILE=/run/secrets/broker_kek
CREDENTIAL_KEY_VERSION=1

# Secrets management. "env" (default) resolves secrets from this file/environment
# exactly as before. A missing managed secret always falls back to the values
# here, so switching backends can never break a working deployment.
#   env       — optional per-secret overrides via ALGO_SECRET_<NAME>
#   aws       — AWS Secrets Manager (needs the `aws` extra / boto3)
#   encrypted — Fernet-encrypted local file (see docs/operations/secrets.md)
SECRETS_BACKEND=env
# SECRETS_ENV_PREFIX=ALGO_SECRET_
# SECRETS_CACHE_TTL_SECONDS=300      # managed-backend refetch interval (rotation)
# AWS_SECRETS_ID=algo-matrics/prod   # secret id/ARN of the JSON secret document
# AWS_REGION=ap-south-1
# SECRETS_ENCRYPTED_FILE=var/secrets.enc
# SECRETS_ENCRYPTION_KEY_FILE=/path/outside/repo/secrets-key

# Cookies / CORS. Set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
APP_BASE_URL=http://localhost:8080

# E-mail. "console" prints verification / reset links to the API logs (dev).
# Switch to "smtp" and fill the SMTP_* values for real delivery.
EMAIL_BACKEND=console
EMAIL_FROM=Algo Matrics <no-reply@algomatrics.local>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# Payment providers (optional; billing works for Free/coupon-covered plans
# without them). Set at least one to enable paid checkout.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=INR
# GST rate (percent) applied to INR invoices; 0 disables tax.
GST_RATE_PERCENT=18

# Event transport behind the abstract EventBus. "redis" (Redis Streams) today;
# kafka/nats/rabbitmq are recognised for forward compatibility and wired later.
EVENT_BUS_BACKEND=redis

# Worker roles this process runs. ["all"] runs every role in one process; set a
# subset (e.g. ["analytics"]) to scale a role in its own container.
WORKER_ROLES=["all"]

# Simulated market data + engine cadence.
MARKET_DATA_SOURCE=simulated
MARKET_TICK_INTERVAL_MS=1000
MARKET_DATA_SEED=20260101
ENGINE_POLL_SECONDS=2.0
OUTBOX_POLL_SECONDS=1.0
SCHEDULER_INTERVAL_SECONDS=60.0

# Writable directories (mounted volume in Docker).
STRATEGY_ARTIFACT_DIR=var/artifacts
UPLOAD_DIR=var/uploads
# Local development only. Keep false in staging/production until uploaded
# strategies execute in an isolated container or microVM.
ALLOW_IN_PROCESS_STRATEGY_UPLOADS=true
# Production: exact hostnames of approved VPS agents, for example
# MT5_AGENT_ALLOWED_HOSTS=["agent-1.example.com","agent-2.example.com"]
MT5_AGENT_ALLOWED_HOSTS=[]

# Rate limiting (sliding window, Redis-backed). Global per-IP limit; per-route
# and per-tenant/user/api-key limits are applied by dependencies, and admins can
# override any named limit or bypass a subject at runtime.
RATE_LIMIT_ENABLED=true
IP_RATE_LIMIT_PER_MINUTE=600
IP_RATE_LIMIT_BURST_PER_SECOND=30

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
