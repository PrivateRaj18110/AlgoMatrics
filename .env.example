# Copy to .env for local Docker Compose. Secrets (JWT keys, broker KEK) are
# generated into a shared volume by the `secrets-init` service, so you do NOT
# set them here. For running processes outside Docker, point the *_FILE paths
# at local files or set the inline *_PEM / *_B64 variables.

APP_ENV=local
LOG_LEVEL=INFO
SERVICE_NAME=algo-api
# Release identity, surfaced at /api/v1/health/info. Injected by CI at build time.
APP_VERSION=0.1.0
BUILD_SHA=unknown

# Observability. The API serves Prometheus metrics at /metrics; background
# processes expose theirs on METRICS_PORT. Restrict /metrics to the scrape
# network at the ingress layer — it is not authenticated.
METRICS_ENABLED=true
METRICS_NAMESPACE=algo
METRICS_PORT=9100
# Consumed by deploy/compose/docker-compose.observability.yml (not the app):
# ALERT_SLACK_WEBHOOK_URL=
# GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me

# Infrastructure (Docker service hostnames).
DATABASE_URL=postgresql+asyncpg://algo:algo@postgres:5432/algo
DATABASE_POOL_SIZE=10
REDIS_URL=redis://redis:6379/0
# Read-only Google telemetry DB used by /api/v1/operations/* (server-side only).
# Leave blank locally for empty states. Required in production (fail-closed 503).
OPS_DATABASE_URL=

# Auth / JWT. In Docker these files are provided by secrets-init.
JWT_ISSUER=algo-matrics
JWT_AUDIENCE=algo-matrics-api
JWT_PRIVATE_KEY_FILE=/run/secrets/jwt_private_key
JWT_PUBLIC_KEY_FILE=/run/secrets/jwt_public_key
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
WS_TICKET_TTL_SECONDS=60

# Broker credential envelope encryption (KEK provided by secrets-init in Docker).
BROKER_CREDENTIAL_KEK_FILE=/run/secrets/broker_kek
CREDENTIAL_KEY_VERSION=1

# Secrets management. "env" (default) resolves secrets from this file/environment
# exactly as before. A missing managed secret always falls back to the values
# here, so switching backends can never break a working deployment.
#   env       — optional per-secret overrides via ALGO_SECRET_<NAME>
#   aws       — AWS Secrets Manager (needs the `aws` extra / boto3)
#   encrypted — Fernet-encrypted local file (see docs/operations/secrets.md)
SECRETS_BACKEND=env
# SECRETS_ENV_PREFIX=ALGO_SECRET_
# SECRETS_CACHE_TTL_SECONDS=300      # managed-backend refetch interval (rotation)
# AWS_SECRETS_ID=algo-matrics/prod   # secret id/ARN of the JSON secret document
# AWS_REGION=ap-south-1
# SECRETS_ENCRYPTED_FILE=var/secrets.enc
# SECRETS_ENCRYPTION_KEY_FILE=/path/outside/repo/secrets-key

# Cookies / CORS. Set COOKIE_SECURE=true behind HTTPS in production.
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
APP_BASE_URL=http://localhost:8080

# OWASP security response headers (HSTS/CSP/frame options). HSTS is only emitted
# in staging/production. Set false only if a proxy already adds these headers.
SECURITY_HEADERS_ENABLED=true

# E-mail. "console" prints verification / reset links to the API logs (dev).
# PRODUCTION: EMAIL_BACKEND=smtp is REQUIRED — with "console" no verification
# or password-reset e-mail ever leaves the server. Checklist for delivery:
#   1. EMAIL_BACKEND=smtp and all SMTP_* values set (transactional provider:
#      SES, Postmark, Brevo, Resend SMTP, ...).
#   2. EMAIL_FROM domain must be algomatrics.in (never .local) and verified
#      with the provider.
#   3. DNS: SPF TXT record + provider DKIM records on algomatrics.in. The
#      domain currently has DMARC p=quarantine, so mail WITHOUT SPF/DKIM
#      alignment is quarantined/spam-foldered.
#   4. APP_BASE_URL must be https://algomatrics.in so links in e-mails work.
EMAIL_BACKEND=console
EMAIL_FROM=Algo Matrics <no-reply@algomatrics.in>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# Payment providers (optional; billing works for Free/coupon-covered plans
# without them). Set at least one to enable paid checkout.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
BILLING_CURRENCY=INR
# GST rate (percent) applied to INR invoices; 0 disables tax.
GST_RATE_PERCENT=18

# AI platform. "null" (default) never calls out; "anthropic" uses Claude and
# needs ANTHROPIC_API_KEY + the `ai` extra. Also gated by the "ai" feature flag.
AI_PROVIDER=null
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-4-8
AI_MAX_TOKENS=2048

# Mobile push delivery. "null" (default) logs instead of calling out and keeps
# the platform hermetic; "fcm" uses Firebase Cloud Messaging (needs credentials).
PUSH_PROVIDER=null
# FCM_CREDENTIALS_JSON=

# High availability. Readiness probes are time-bounded so a hung dependency
# cannot block the load balancer; the breaker guards outbound calls (webhooks).
READINESS_TIMEOUT_SECONDS=2.0
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30.0

# Auto scaling. The event stream + consumer groups an autoscaler watches, and
# how much backlog one worker replica should absorb. Groups are named
# worker:<role> (e.g. worker:notification). Empty groups list = report nothing.
SCALING_EVENT_STREAM=events
SCALING_CONSUMER_GROUPS=["worker:notification","worker:trading"]
SCALING_TARGET_BACKLOG_PER_REPLICA=100
SCALING_MIN_REPLICAS=1
SCALING_MAX_REPLICAS=10

# Event transport behind the abstract EventBus. "redis" (Redis Streams) today;
# kafka/nats/rabbitmq are recognised for forward compatibility and wired later.
EVENT_BUS_BACKEND=redis

# Worker roles this process runs. ["all"] runs every role in one process; set a
# subset (e.g. ["analytics"]) to scale a role in its own container.
WORKER_ROLES=["all"]

# Simulated market data + engine cadence.
MARKET_DATA_SOURCE=simulated
MARKET_TICK_INTERVAL_MS=1000
MARKET_DATA_SEED=20260101
ENGINE_POLL_SECONDS=2.0
OUTBOX_POLL_SECONDS=1.0
SCHEDULER_INTERVAL_SECONDS=60.0

# Market intelligence (AI-CIO). Read-only, advisory. Point AICIO_DUCKDB_PATH at
# the DuckDB file the AI-CIO pipeline writes to enable the /market-intel API and
# the console's Market Intel page. Unset => the feature is dormant (empty reads).
# Under Docker Compose this is set to the shared volume path automatically; set it
# here only for a non-Docker run (e.g. ai_cio_phase1/ai_cio_phase1/aicio.duckdb).
# AICIO_DUCKDB_PATH=
# The trading engine logs, at each run start, what AI-CIO *would* advise, without
# changing execution. Leave enabled to accumulate the 30+ days of shadow data a
# future live rollout is gated on.
AICIO_SHADOW_GATE_ENABLED=true

# Writable directories (mounted volume in Docker).
STRATEGY_ARTIFACT_DIR=var/artifacts
UPLOAD_DIR=var/uploads
# Local development only. Keep false in staging/production until uploaded
# strategies execute in an isolated container or microVM.
ALLOW_IN_PROCESS_STRATEGY_UPLOADS=true
# Production: exact hostnames of approved VPS agents, for example
# MT5_AGENT_ALLOWED_HOSTS=["agent-1.example.com","agent-2.example.com"]
MT5_AGENT_ALLOWED_HOSTS=[]

# Rate limiting (sliding window, Redis-backed). Global per-IP limit; per-route
# and per-tenant/user/api-key limits are applied by dependencies, and admins can
# override any named limit or bypass a subject at runtime.
RATE_LIMIT_ENABLED=true
IP_RATE_LIMIT_PER_MINUTE=600
IP_RATE_LIMIT_BURST_PER_SECOND=30

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# Ops dashboard (served at /ops; see docs/operations/ops-dashboard.md).
# The ops-api service reads this file too. Set an org-scoped read API key
# (POST /api/v1/api-keys) to feed it live platform data; leave blank to run
# the ops dashboard on its bundled mock data.
# ALGOMATRICS_API_KEY=
# ALGOMATRICS_ORG_ID=
