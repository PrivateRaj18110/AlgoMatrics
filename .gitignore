.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
node_modules/
.vite/
*.log
data/
# Local secret material only (repo-root dir). Anchored with a leading slash so
# it never matches the source package
# backend/src/algo_platform/shared/infrastructure/secrets/, which must be
# committed. The encrypted document lives under var/ (ignored above).
/secrets/
# Local secrets management: never commit plaintext or encryption keys. The
# encrypted document itself (secrets.enc) is safe but the key must stay out.
secrets.plain.json
*.secrets.plain.json
.secrets-key
secrets-key*
var/
.idea/
.vscode/
frontend/dist/
frontend/tsconfig.tsbuildinfo
*.tsbuildinfo

# The vendored AI-CIO project ships required input data (the NSE universe CSVs)
# that the generic `data/` rule above would otherwise drop — keep it. Its
# generated per-run outputs and the DuckDB it writes stay ignored.
!ai_cio_phase1/ai_cio_phase1/data/
ai_cio_phase1/ai_cio_phase1/output/
ai_cio_phase1/**/*.duckdb

