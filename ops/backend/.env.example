# Raj Quant OS — backend environment
# Copy to `.env` and adjust.

APP_NAME="Raj Quant OS API"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

API_PREFIX=/api
# Comma-separated allowed CORS origins (the frontend dev + prod URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Leave DATABASE_URL blank to run on the in-memory mock repositories (DEV ONLY).
# Set it to enable PostgreSQL-backed persistence (machines, events, logs, trades,
# metrics, sync_state, sessions, dead letters). Run `alembic upgrade head` from
# backend/ before first start.
#   Postgres : postgresql+psycopg://user:pass@host:5432/raj_quant_os
#   SQLite   : sqlite:///./raj_dev.db   (dev/test only)
#
# With ENVIRONMENT=production this MUST be set: the service refuses to start on
# in-memory repositories, where telemetry is lost on restart and deduplication is
# disabled. Use a database dedicated to ops telemetry, NOT the platform database.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Agent ingestion credentials (REQUIRED in production) ---
# The Raj Local Agent authenticates every /api/agent/* and /api/ingest/* request
# with the `X-Raj-Agent-Token` header. Without a credential configured here the
# endpoints reject everything (fail closed) — they are never left open.
#
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Machine-scoped credentials (PREFERRED) — "machine:token" pairs, comma
# separated. A leaked token is then confined to one machine's telemetry, and a
# request whose payload names a different machine is rejected with 403.
# The machine name must match the agent's `machine.name` / RAJ_MACHINE exactly.
RAJ_AGENT_TOKENS=
# Fleet-wide fallback — any machine may use it. Simpler, but a leak lets an
# attacker forge telemetry for every host. Prefer RAJ_AGENT_TOKENS.
RAJ_AGENT_TOKEN=

# --- Dashboard websocket credential (REQUIRED in production) ---
# /api/ws streams live machine state, trades and events, so subscribers must
# authenticate. Sent by the browser in the `Sec-WebSocket-Protocol` header
# (never the query string, which would leak it into access logs).
# NOTE: a shared token in a browser SPA authenticates "a dashboard", not "a
# person". Prefer OPS_JWT_PUBLIC_KEY below where the platform login is available.
RAJ_DASHBOARD_TOKEN=

# Optional: PEM public key of the platform's RS256 access tokens. When set (and
# PyJWT is installed) platform JWTs are accepted on the websocket, giving real
# per-user identity and expiry. Only the PUBLIC key is needed — no secret
# crosses the service boundary.
OPS_JWT_PUBLIC_KEY=
OPS_JWT_ISSUER=
OPS_JWT_AUDIENCE=
# REST dashboard APIs require this credential automatically in production.
# Enable in staging/dev to exercise the same fail-closed read path locally.
OPS_REST_AUTH_REQUIRED=false

# --- Ingestion limits ---
# Max envelopes in one /api/agent/batch call. The agent's own batch size is 200
# (raj_monitor DEFAULT_BATCH_SIZE); this ceiling leaves replay headroom while
# bounding the work a single request can demand.
INGEST_MAX_BATCH_ITEMS=1000
# Rolling retention for the idempotency table. Must exceed the agent's longest
# realistic offline window: an envelope replayed after its dedup row is pruned
# would be processed a second time.
INGEST_DEDUP_RETENTION_DAYS=7
# Disabled-by-default destructive retention. Configure each class explicitly;
# do not use one arbitrary lifetime for every ops dataset.
TELEMETRY_RETENTION_DAYS=0
OPERATIONAL_EVENT_RETENTION_DAYS=0
DEAD_LETTER_RETENTION_DAYS=0
SESSION_RETENTION_DAYS=0

# --- Heartbeat/status thresholds ---
# AWS does not poll Google. Machine status is derived from the age of the last
# heartbeat the agent reported: fresh => online, older than DEGRADED => degraded,
# older than OFFLINE => offline, missing heartbeat => unknown.
HEARTBEAT_INTERVAL_SECONDS=10
HEARTBEAT_DEGRADED_AFTER_SECONDS=30
HEARTBEAT_OFFLINE_AFTER_SECONDS=120

# --- EOD dataset landing ---
# The agent can register an end-of-day manifest, upload bounded chunks, and
# finalize once checksums pass. PostgreSQL stores only metadata/progress; raw
# files are written behind this storage port. `local` is for dev/single-node
# deployment; production should move this port to S3/object storage before
# scaling multiple API replicas.
EOD_STORAGE_BACKEND=local
EOD_STORAGE_ROOT=var/eod-datasets
EOD_MAX_CHUNK_BYTES=26214400
# For EOD_STORAGE_BACKEND=s3/object/s3-compatible. Credentials are loaded by
# boto3's standard provider chain (IRSA/workload identity, instance profile, or
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY supplied by your secret manager).
EOD_S3_BUCKET=
EOD_S3_PREFIX=algomatrics/eod
EOD_S3_REGION=
EOD_S3_ENDPOINT_URL=
EOD_S3_FORCE_PATH_STYLE=false
EOD_S3_SERVER_SIDE_ENCRYPTION=
# Retention is disabled by default so research data is not silently deleted.
EOD_METADATA_RETENTION_DAYS=0
EOD_RAW_RETENTION_DAYS=0

# --- Quant analytics / replay ---
# Bounded on-purpose: this API process is not a bulk data warehouse. The first
# Phase 3 analytics layer parses finalized EOD CSV/JSONL files for dashboard
# reports and deterministic synthetic replay. Larger scans should move behind
# DuckDB/object storage workers.
QUANT_MAX_FILE_BYTES=52428800
QUANT_MAX_ROWS=500000
QUANT_REPLAY_MAX_POINTS=2000
QUANT_SYNTHETIC_MAX_STEPS=10000
QUANT_REPORT_RETENTION_DAYS=0

# --- AlgoMatrics control plane (live platform data) ---
# When all three are set, the trading-domain endpoints (dashboard, strategies,
# trades, risk, analytics, brokers, accounts) serve live data from the
# AlgoMatrics /api/v1 API instead of mock fixtures. Create an org-scoped
# read-key via POST /api/v1/api-keys (see docs/operations/ops-dashboard.md).
#   Docker compose : http://api:8000/api/v1
#   Local dev      : http://localhost:8000/api/v1
ALGOMATRICS_API_URL=
ALGOMATRICS_API_KEY=
ALGOMATRICS_ORG_ID=
