# Raj Quant OS — backend environment
# Copy to `.env` and adjust.

APP_NAME="Raj Quant OS API"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

API_PREFIX=/api
# Comma-separated allowed CORS origins (the frontend dev + prod URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Leave DATABASE_URL blank to run on the in-memory mock repositories.
# Set it to enable PostgreSQL-backed persistence (machines, events, logs, trades,
# metrics). Run `alembic upgrade head` from backend/ before first start.
#   Postgres : postgresql+psycopg://user:pass@host:5432/raj_quant_os
#   SQLite   : sqlite:///./raj_dev.db   (dev/test only)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- AlgoMatrics control plane (live platform data) ---
# When all three are set, the trading-domain endpoints (dashboard, strategies,
# trades, risk, analytics, brokers, accounts) serve live data from the
# AlgoMatrics /api/v1 API instead of mock fixtures. Create an org-scoped
# read-key via POST /api/v1/api-keys (see docs/operations/ops-dashboard.md).
#   Docker compose : http://api:8000/api/v1
#   Local dev      : http://localhost:8000/api/v1
ALGOMATRICS_API_URL=
ALGOMATRICS_API_KEY=
ALGOMATRICS_ORG_ID=
