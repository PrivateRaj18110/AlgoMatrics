# AlgoMatrics Ops Dashboard — frontend environment
#
# Copy to `.env.local` and adjust. When VITE_API_BASE_URL is empty the app runs
# entirely on the bundled mock data layer (no backend required).

# Ops backend API base URL.
#   Local dev (vite proxy → ops backend on :8001):  /ops/api
#   Direct to a local ops backend:                  http://localhost:8001/api
#   Behind the AlgoMatrics nginx (Docker/prod):     /ops/api
VITE_API_BASE_URL=

# Force mock mode even if an API base URL is set ("true" / "false")
VITE_USE_MOCK=true

# Version label shown in the UI
VITE_APP_VERSION=1.0.0

# Viewer credential for REST dashboard APIs. Prefer a short-lived per-user
# platform access token where available. If left blank, live fetches fall back to
# VITE_OPS_WS_TOKEN for the interim shared-dashboard-token deployment model.
VITE_OPS_API_TOKEN=

# Viewer credential for the live telemetry websocket (/api/ws). Must match the
# backend's RAJ_DASHBOARD_TOKEN, or be a platform access token when the backend
# is configured with OPS_JWT_PUBLIC_KEY. Without it the backend refuses the
# websocket handshake and the live feed stays empty.
#
# Not needed in mock mode. Note that a build-time value is embedded in the
# JS bundle — it identifies the dashboard, not an individual user.
VITE_OPS_WS_TOKEN=
